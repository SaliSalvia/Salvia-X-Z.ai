<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/sheet_bg"
    android:layoutDirection="rtl"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="10dp"
        android:background="@drawable/sheet_handle" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginEnd="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/system_prompt_title"
                android:textColor="@color/ink_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/system_prompt_subtitle"
                android:textColor="@color/ink_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/swSystemEnabled"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border_hairline" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="10dp"
        android:paddingBottom="6dp"
        android:text="@string/system_prompt_presets_label"
        android:textColor="@color/ink_secondary"
        android:textSize="11sp"
        android:textStyle="bold" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/presetEngineer"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginEnd="8dp"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:background="@drawable/chip_bg"
                android:clickable="true"
                android:focusable="true"
                android:text="@string/preset_engineer_label"
                android:textColor="@color/ink_primary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/presetTranslator"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginEnd="8dp"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:background="@drawable/chip_bg"
                android:clickable="true"
                android:focusable="true"
                android:text="@string/preset_translator_label"
                android:textColor="@color/ink_primary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/presetAnalyst"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginEnd="8dp"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:background="@drawable/chip_bg"
                android:clickable="true"
                android:focusable="true"
                android:text="@string/preset_analyst_label"
                android:textColor="@color/ink_primary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/presetConcise"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:background="@drawable/chip_bg"
                android:clickable="true"
                android:focusable="true"
                android:text="@string/preset_concise_label"
                android:textColor="@color/ink_primary"
                android:textSize="12sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <EditText
        android:id="@+id/etSystemPrompt"
        android:layout_width="match_parent"
        android:layout_height="128dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/search_box_bg"
        android:gravity="top|start"
        android:hint="@string/system_prompt_hint"
        android:inputType="textMultiLine|textCapSentences"
        android:maxLength="4000"
        android:padding="12dp"
        android:scrollbars="vertical"
        android:textColor="@color/ink_primary"
        android:textColorHint="@color/ink_muted"
        android:textDirection="anyRtl"
        android:textSize="13.5sp"
        android:importantForAutofill="no" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="6dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/tvSystemStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/system_prompt_status_off"
            android:textColor="@color/ink_secondary"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tvSystemCharCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/system_prompt_char_count_initial"
            android:textColor="@color/ink_secondary"
            android:textSize="11sp"
            android:layoutDirection="ltr" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border_hairline" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="10dp">

        <TextView
            android:id="@+id/btnSystemClear"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:background="@drawable/btn_ghost_bg"
            android:clickable="true"
            android:focusable="true"
            android:text="@string/system_prompt_clear"
            android:textColor="@color/status_error"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnSystemCancel"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:background="@drawable/btn_ghost_bg"
            android:clickable="true"
            android:focusable="true"
            android:text="@string/close"
            android:textColor="@color/ink_secondary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnSystemSave"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:gravity="center"
            android:background="@drawable/chip_bg_primary"
            android:clickable="true"
            android:focusable="true"
            android:text="@string/system_prompt_save"
            android:textColor="@color/accent_on_primary"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
